# ==============================================================================
# CHARTERED ARCHIVE — ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development or add these as Repository
# Variables / Secrets in GitHub Actions for GitHub Pages deployment.
# You can also place public read-only folder IDs directly in src/config/driveConfig.ts.

# 1. Google Drive API v3 Key (Free tier: 1 billion queries/day)
# Restrict this key in Google Cloud Console by HTTP referrer (your GitHub Pages domain)
# and restrict API access strictly to "Google Drive API".
VITE_GOOGLE_DRIVE_API_KEY=""

# 2. Allowlisted Public-View Folder IDs (ONLY these folders are ever queried; root is never accessed)
# Financial Reporting
VITE_DRIVE_FR_MODULES_FOLDER_ID=""
VITE_DRIVE_FR_REVISIONS_FOLDER_ID=""
VITE_DRIVE_FR_COMBINED_FOLDER_ID=""
VITE_DRIVE_FR_QUIZ_FOLDER_ID=""

# Advanced Audit
VITE_DRIVE_AA_MODULES_FOLDER_ID=""
VITE_DRIVE_AA_REVISIONS_FOLDER_ID=""
VITE_DRIVE_AA_COMBINED_FOLDER_ID=""
VITE_DRIVE_AA_QUIZ_FOLDER_ID=""

# Advanced Financial Management
VITE_DRIVE_AFM_MODULES_FOLDER_ID=""
VITE_DRIVE_AFM_REVISIONS_FOLDER_ID=""
VITE_DRIVE_AFM_COMBINED_FOLDER_ID=""
VITE_DRIVE_AFM_QUIZ_FOLDER_ID=""

# Indirect Taxes
VITE_DRIVE_IDT_MODULES_FOLDER_ID=""
VITE_DRIVE_IDT_REVISIONS_FOLDER_ID=""
VITE_DRIVE_IDT_COMBINED_FOLDER_ID=""
VITE_DRIVE_IDT_QUIZ_FOLDER_ID=""

# Direct Taxes
VITE_DRIVE_DT_MODULES_FOLDER_ID=""
VITE_DRIVE_DT_REVISIONS_FOLDER_ID=""
VITE_DRIVE_DT_COMBINED_FOLDER_ID=""
VITE_DRIVE_DT_QUIZ_FOLDER_ID=""

# 3. Private Google Sheet Feedback Endpoint (Free Google Apps Script Web App URL)
# See docs/google-apps-script/Code.gs for the 1-minute setup script.
VITE_FEEDBACK_APPS_SCRIPT_URL=""

# 4. Future Descriptive Answer Upload & Evaluation Lookup Endpoint (Free Google Apps Script Web App URL)
VITE_DESCRIPTIVE_APPS_SCRIPT_URL=""
